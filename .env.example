PORT=5000
NODE_ENV=development
# Set NODE_ENV=production and your exact HTTPS origin in cPanel.
DB_HOST=localhost
DB_PORT=3306
DB_USER=candidate_app
DB_PASSWORD=replace_with_secure_password
DB_NAME=candidate_system
SESSION_SECRET=replace_with_at_least_32_random_characters
FRONTEND_ORIGIN=http://localhost:5173
# Relative upload paths remain relative to backend/ to preserve existing files.
UPLOAD_DIR=./uploads
# Maximum original image size; saved images are compressed to at most 3 MB each.
MAX_UPLOAD_MB=15
