{
  "name": "student-inventory",
  "version": "0.0.0",
  "private": true,
  "main": "app.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node app.js",
    "setup": "npm --prefix frontend install && npm --prefix backend install",
    "dev:api": "npm --prefix backend run dev",
    "start:api": "npm --prefix backend start",
    "db:init": "npm --prefix backend run db:init",
    "admin:create": "npm --prefix backend run admin:create",
    "test": "npm --prefix backend test",
    "test:browser": "npm --prefix backend run test:browser",
    "dev": "npm --prefix frontend run dev --",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview --"
  }
}
